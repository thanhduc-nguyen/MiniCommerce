@page
@model MiniCommerce.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <h4 class="text-center display-6 mt-3 mb-3">AI Commerce</h4>

    <div class="container">
        <div class="row">
            @if (@Model.AiAgentModel.UserGuid != Guid.Empty)
            {
                <div id="ai-chat-log" class="mb-3"></div>
                <form id="ai-prompt-form" method="post">
                    @Html.AntiForgeryToken()
                    <div class="input-group mb-3">
                        <button id="ai-provider-toggle" class="btn btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">Microsoft AI Agent</button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" data-provider="My Own AI Agent">My Own AI Agent</a></li>
                            <li><a class="dropdown-item" href="#" data-provider="Microsoft AI Agent">Microsoft AI Agent</a>
                            </li>
                        </ul>
                        <input asp-for="AiAgentModel.Provider" id="ai-provider-input" type="hidden"
                               value="Microsoft AI Agent" />
                        <input asp-for="AiAgentModel.UserGuid" id="ai-user-guid-input" type="hidden"
                               value="@Model.AiAgentModel.UserGuid" />
                        <input asp-for="AiAgentModel.Prompt" id="ai-prompt-input" type="text" class="form-control"
                               autocomplete="off" />
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    You need to log in to use the AI agent.
                </div>
            }
        </div>
    </div>

    @section Scripts {
        <script src="~/scripts/ai-chat.js"></script>
    }
</div>
