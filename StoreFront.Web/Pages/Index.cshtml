@page
@model StoreFront.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <h4 class="text-center display-6 mt-3 mb-3">@Model.Slogan</h4>

    <div class="row">
        @foreach (var product in Model.ProductsOfTheWeek)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</div>
